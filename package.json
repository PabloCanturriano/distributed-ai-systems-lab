{
  "name": "distributed-ai-systems-lab",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "build": "npm run build --workspace=@lab/configuration --workspace=@lab/telemetry --workspace=@lab/knowledge && npm run build --workspace=@lab/api --workspace=@lab/worker --workspace=@lab/database --workspace=@lab/cli --workspace=@lab/operations",
    "typecheck": "npm run build --workspace=@lab/configuration --workspace=@lab/telemetry --workspace=@lab/knowledge && npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && jest --runInBand",
    "check": "npm run format:check && npm run typecheck && npm test",
    "test:containers": "node scripts/container-smoke.mjs",
    "test:database": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.database.config.cjs --runInBand",
    "test:compose": "node scripts/compose-smoke.mjs",
    "test:kafka": "node scripts/kafka-smoke.mjs",
    "test:kafka-client": "node scripts/kafka-client-smoke.mjs",
    "test:relay": "node scripts/scenarios.mjs run crash-after-publication",
    "test:consumer": "node scripts/scenarios.mjs run crash-after-scheduling",
    "test:executor": "node scripts/executor-smoke.mjs",
    "test:cli": "node scripts/cli-smoke.mjs",
    "test:replay": "node scripts/replay-smoke.mjs",
    "test:tracing": "node scripts/tracing-smoke.mjs",
    "test:phase2": "node scripts/phase2-check.mjs",
    "test:operations": "node scripts/scenarios.mjs run delivery-repair",
    "test:response-crash": "node scripts/scenarios.mjs run crash-after-response",
    "test:observability": "node scripts/scenarios.mjs run collector-outage",
    "test:phase3": "node scripts/phase3-check.mjs",
    "evaluate:retrieval": "node scripts/retrieval-eval.mjs",
    "test:rag": "node scripts/rag-smoke.mjs",
    "test:phase4": "node scripts/phase4-check.mjs",
    "test:phase5": "node scripts/phase5-check.mjs",
    "evaluate:workflow": "npm run build && node scripts/agent-workflow-eval.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "@testcontainers/postgresql": "12.2.1"
  }
}
